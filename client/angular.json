{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "client": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-builders/custom-webpack:browser",
          "options": {
            "outputPath": "dist/client",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "*.css",
                "input": "src/environments/",
                "output": "/environments/"
              },
              {
                "glob": "molstar.js",
                "input": "node_modules/molstar/build/viewer",
                "output": "/assets/vendor/molstar"
              },
              {
                "glob": "pdf.worker.min.mjs",
                "input": "node_modules/pdfjs-dist/build",
                "output": "/assets/vendor/pdfjs"
              },
              {
                "glob": "plotly.min.js",
                "input": "node_modules/plotly.js-dist-min",
                "output": "/assets/vendor/plotly"
              }
            ],
            "styles": [
              "node_modules/tachyons/css/tachyons.css",
              "src/theme.scss",
              "src/scss/bootstrap.scss",
              "src/styles.scss",
              "node_modules/@fontsource/roboto/300.css",
              "node_modules/@fontsource/roboto/300-italic.css",
              "node_modules/@fontsource/roboto/400.css",
              "node_modules/@fontsource/roboto/400-italic.css",
              "node_modules/@fontsource/roboto/700.css",
              "node_modules/@fontsource/roboto/700-italic.css",
              "node_modules/@fontsource/ibm-plex-sans/300.css",
              "node_modules/@fontsource/ibm-plex-sans/400.css",
              "node_modules/@fontsource/ibm-plex-sans/600.css",
              "node_modules/@fontsource/inter/300.css",
              "node_modules/@fontsource/inter/400.css",
              "node_modules/@fontsource/inter/600.css",
              "node_modules/@fontsource/inter/700.css"
            ],
            "scripts": [
              "node_modules/vis-network/dist/vis-network.min.js",
              "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
            ],
            "webWorkerTsConfig": "tsconfig.worker.json",
            "stylePreprocessorOptions": {
              "includePaths": ["."]
            },
            "customWebpackConfig": {
              "path": "./webpack.config.js"
            }
          },
          "configurations": {
            "dev": {
              "optimization": false,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": false,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "31mb",
                  "maximumError": "40mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "72kb",
                  "maximumError": "80kb"
                }
              ]
            },
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "31mb",
                  "maximumError": "40mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "72kb",
                  "maximumError": "80kb"
                }
              ]
            },
            "staging": {},
            "qa": {},
            "demo": {}
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "client:build"
          },
          "configurations": {
            "production": {
              "browserTarget": "client:build:production"
            },
            "staging": {
              "browserTarget": "client:build:production,staging"
            },
            "qa": {
              "browserTarget": "client:build:production,qa"
            },
            "demo": {
              "browserTarget": "client:build:production,demo"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "client:build"
          }
        },
        "test": {
          "builder": "@angular-builders/custom-webpack:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "assets": ["src/favicon.ico", "src/assets"],
            "styles": [
              "src/scss/bootstrap.scss",
              "src/theme.scss",
              "src/styles.scss"
            ],
            "include": ["src/**/*.spec.ts", "src/**/*.d.ts"],
            "scripts": ["node_modules/molstar/build/viewer/molstar.js"],
            "stylePreprocessorOptions": {
              "includePaths": ["."]
            },
            "customWebpackConfig": {
              "path": "./webpack.config.js"
            }
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "client:build",
            "compodoc": false,
            "styles": [
              "node_modules/tachyons/css/tachyons.css",
              "src/theme.scss",
              "src/scss/bootstrap.scss",
              "src/styles.scss",
              "node_modules/@fortawesome/fontawesome-free/css/all.css",
              "node_modules/@fortawesome/fontawesome-free/css/v4-shims.css",
              "node_modules/@fontsource/roboto/index.css",
              "node_modules/@fontsource/ibm-plex-sans/index.css",
              "node_modules/@fontsource/inter/index.css"
            ],
            "port": 6006,
            "tsConfig": "tsconfig.storybook.json"
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "client:build",
            "compodoc": false,
            "styles": [
              "node_modules/tachyons/css/tachyons.css",
              "src/theme.scss",
              "src/scss/bootstrap.scss",
              "src/styles.scss",
              "node_modules/@fortawesome/fontawesome-free/css/all.css",
              "node_modules/@fortawesome/fontawesome-free/css/v4-shims.css",
              "node_modules/@fontsource/roboto/index.css",
              "node_modules/@fontsource/ibm-plex-sans/index.css",
              "node_modules/@fontsource/inter/index.css"
            ],
            "outputDir": "storybook-static",
            "tsConfig": "tsconfig.storybook.json"
          }
        }
      }
    }
  },
  "defaultProject": "client",
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "cli": {
    "analytics": false
  }
}
