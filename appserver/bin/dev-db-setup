#!/usr/bin/env bash
#
# Reset and migrate the development PostgreSQL database, then rebuild the
# Elasticsearch search index. Run this inside the appserver container.
#
# Destructive: `flask drop_tables` drops every table and enum in the public
# schema without prompting.
#
# This covers PostgreSQL and Elasticsearch only. Neo4j runs as a separate
# stack and its constraints and indexes are created by the Liquibase
# migrator — see `graph-db/Makefile` (`make -C graph-db dev-up migrate`).

set -euo pipefail

echo "Dropping all tables and enums"
flask drop_tables

echo "Running PostgreSQL migrations"
flask db upgrade --x-arg data_migrate="True"

echo "Rebuilding the Elasticsearch search index"
flask reset-search-index

echo
echo "Done. Load the fixture data, including the default admin user, with:"
echo "  flask seed"
