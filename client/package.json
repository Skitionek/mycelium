{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev-start": "ng serve --host=0.0.0.0 --disable-host-check --proxy-config=proxy.conf.js",
    "build": "node --max_old_space_size=4096 ./node_modules/@angular/cli/bin/ng build",
    "test": "ng test --watch=false --progress=false --browsers=ChromeCustom",
    "test:codespace": "npx -y @puppeteer/browsers install chrome@stable --path ~/.cache/puppeteer >/dev/null && NODE_OPTIONS=--openssl-legacy-provider ng test --watch=false --progress=false --browsers=ChromeCustom",
    "test:codespace:watch": "npx -y @puppeteer/browsers install chrome@stable --path ~/.cache/puppeteer >/dev/null && NODE_OPTIONS=--openssl-legacy-provider ng test --watch=true --progress=false --browsers=ChromeCustom",
    "lint": "eslint src",
    "storybook": "ng run client:storybook",
    "build-storybook": "ng run client:build-storybook",
    "snapshot": "concurrently -k -s first -n SB,TEST \"yarn snapshot:serve\" \"wait-on tcp:127.0.0.1:6006 && test-storybook --ci\"",
    "snapshot:docker": "docker run --rm --ipc=host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -v \"$PWD/..\":/repo -w /repo/client mcr.microsoft.com/playwright:v1.64.1-noble yarn snapshot",
    "check-story-coverage": "node tools/check-story-coverage.js",
    "snapshot:serve": "http-server storybook-static -p 6006 --silent",
    "snapshot:update": "concurrently -k -s first -n SB,TEST \"yarn snapshot:serve\" \"wait-on tcp:127.0.0.1:6006 && test-storybook -u\"",
    "snapshot:docker:update": "docker run --rm --ipc=host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -v \"$PWD/..\":/repo -w /repo/client mcr.microsoft.com/playwright:v1.64.1-noble yarn snapshot:update"
  },
  "lint-staged": {
    "*.{ts,html}": "eslint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~16.2.0",
    "@angular/cdk": "~16.2.0",
    "@angular/common": "~16.2.0",
    "@angular/compiler": "~16.2.0",
